#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
default_source="$(cd "$script_dir/../.." && pwd)"
default_map="$script_dir/snapshot-map.json"

source_workspace="$default_source"
source_ref=""
destination=""
map_file="$default_map"
mode="verify-only"

usage() {
  cat <<'EOF'
用法：
  tools/migration/create-snapshot --destination <空目录> [选项]

默认仅预检并打印迁移计划；传入 --apply 才会创建目标仓库。

选项：
  --source-workspace <路径>  源 workspace，默认当前仓库
  --source-ref <40位SHA>     源顶层提交，默认读取 snapshot-map.json
  --destination <路径>       新 monorepo 目录；必须不存在
  --map <JSON路径>           目录映射，默认 tools/migration/snapshot-map.json
  --verify-only              只做源基线预检（默认）
  --apply                    创建并验证无父 root commit
  -h, --help                 显示帮助

此工具不会创建远端、推送、删除源文件或覆盖已有目录。
EOF
}

die() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "缺少命令：$1"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source-workspace)
      [[ $# -ge 2 ]] || die "--source-workspace 缺少参数"
      source_workspace="$2"
      shift 2
      ;;
    --source-ref)
      [[ $# -ge 2 ]] || die "--source-ref 缺少参数"
      source_ref="$2"
      shift 2
      ;;
    --destination)
      [[ $# -ge 2 ]] || die "--destination 缺少参数"
      destination="$2"
      shift 2
      ;;
    --map)
      [[ $# -ge 2 ]] || die "--map 缺少参数"
      map_file="$2"
      shift 2
      ;;
    --verify-only)
      mode="verify-only"
      shift
      ;;
    --apply)
      mode="apply"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "未知参数：$1"
      ;;
  esac
done

for command_name in git jq tar realpath mktemp date node; do
  need_command "$command_name"
done

[[ -n "$destination" ]] || die "缺少 --destination"
[[ -f "$map_file" ]] || die "映射文件不存在：$map_file"
sanitizer="$script_dir/sanitize-snapshot.mjs"
[[ -f "$sanitizer" ]] || die "净化脚本不存在：$sanitizer"
jq -e '.schemaVersion == 1 and (.components | type == "array" and length > 0)' \
  "$map_file" >/dev/null || die "映射文件格式无效"

if [[ -z "$source_ref" ]]; then
  source_ref="$(jq -r '.sourceRef // empty' "$map_file")"
fi
[[ "$source_ref" =~ ^[0-9a-f]{40}$ ]] || die "--source-ref 必须是完整的 40 位 SHA"

source_workspace="$(realpath "$source_workspace")"
destination="$(realpath -m "$destination")"
map_file="$(realpath "$map_file")"

[[ "$(git -C "$source_workspace" rev-parse --show-toplevel 2>/dev/null)" == "$source_workspace" ]] ||
  die "源路径不是 Git workspace 根目录：$source_workspace"
git -C "$source_workspace" cat-file -e "$source_ref^{commit}" 2>/dev/null ||
  die "源 workspace 不包含提交：$source_ref"
[[ "$(git -C "$source_workspace" rev-parse HEAD)" == "$source_ref" ]] ||
  die "源 workspace HEAD 不是指定基线 $source_ref"

case "$destination/" in
  "$source_workspace/"*) die "目标目录不能位于源 workspace 内" ;;
esac
case "$source_workspace/" in
  "$destination/"*) die "源 workspace 不能位于目标目录内" ;;
esac

if [[ -e "$destination" ]]; then
  die "目标目录已经存在，拒绝覆盖：$destination"
fi

source_tree="$(git -C "$source_workspace" rev-parse "$source_ref^{tree}")"
source_commit_date="$(git -C "$source_workspace" show -s --format=%cI "$source_ref")"
captured_at="$(date --iso-8601=seconds)"
sources_ndjson="$(mktemp /tmp/trojanpanel-snapshot-sources.XXXXXX)"
commit_message="$(mktemp /tmp/trojanpanel-snapshot-message.XXXXXX)"
sanitization_report="$(mktemp /tmp/trojanpanel-snapshot-sanitization.XXXXXX)"

cleanup_temp_files() {
  [[ ! -f "$sources_ndjson" ]] || unlink "$sources_ndjson"
  [[ ! -f "$commit_message" ]] || unlink "$commit_message"
  [[ ! -f "$sanitization_report" ]] || unlink "$sanitization_report"
}
trap cleanup_temp_files EXIT

total_files=0
total_imported_files=0
printf '源 workspace：%s\n' "$source_workspace"
printf '源提交：%s（%s）\n' "$source_ref" "$source_commit_date"
printf '目标目录：%s\n' "$destination"
printf '模式：%s\n' "$mode"
printf '\n%-30s %-40s %-8s %-7s %s\n' 'SOURCE' 'COMMIT' 'POLICY' 'FILES' 'TARGET'

while IFS=$'\t' read -r name source_path target_path repository import_policy expected_imported_files; do
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "无效 source 名称：$name"
  [[ "$source_path" =~ ^[A-Za-z0-9._/-]+$ && "$source_path" != /* && "$source_path" != *..* ]] ||
    die "无效 sourcePath：$source_path"
  [[ "$target_path" =~ ^[A-Za-z0-9._/-]+$ && "$target_path" != /* && "$target_path" != *..* ]] ||
    die "无效 targetPath：$target_path"
  [[ "$import_policy" == "exact" || "$import_policy" == "sanitize" ]] ||
    die "$name 的 importPolicy 必须是 exact 或 sanitize"
  [[ "$expected_imported_files" =~ ^[0-9]+$ ]] ||
    die "$name 的 expectedImportedFiles 必须是非负整数"

  entry="$(git -C "$source_workspace" ls-tree "$source_ref" -- "$source_path")"
  read -r entry_mode entry_type commit entry_path <<<"$entry"
  [[ "$entry_mode" == "160000" && "$entry_type" == "commit" && "$entry_path" == "$source_path" ]] ||
    die "$source_path 不是 $source_ref 中的 gitlink"

  local_repo="$source_workspace/$source_path"
  git -C "$local_repo" cat-file -e "$commit^{commit}" 2>/dev/null ||
    die "本地 source 缺少 gitlink commit：$name $commit"
  [[ "$(git -C "$local_repo" rev-parse HEAD)" == "$commit" ]] ||
    die "$name 当前 HEAD 与 gitlink 不一致"
  [[ -z "$(git -C "$local_repo" status --porcelain --untracked-files=normal)" ]] ||
    die "$name 工作树不干净"

  tree="$(git -C "$local_repo" rev-parse "$commit^{tree}")"
  files="$(git -C "$local_repo" ls-tree -r --name-only "$commit" | wc -l)"
  total_files=$((total_files + files))
  total_imported_files=$((total_imported_files + expected_imported_files))
  printf '%-30s %-40s %-8s %-7s %s\n' \
    "$name" "$commit" "$import_policy" "$expected_imported_files" "$target_path"

  jq -cn \
    --arg name "$name" \
    --arg sourcePath "$source_path" \
    --arg targetPath "$target_path" \
    --arg repository "$repository" \
    --arg commit "$commit" \
    --arg tree "$tree" \
    --arg importPolicy "$import_policy" \
    --argjson files "$files" \
    --argjson expectedImportedFiles "$expected_imported_files" \
    '{name:$name,sourcePath:$sourcePath,targetPath:$targetPath,repository:$repository,commit:$commit,tree:$tree,files:$files,importPolicy:$importPolicy,expectedImportedFiles:$expectedImportedFiles}' \
    >>"$sources_ndjson"
done < <(jq -r '.components[] | [.name,.sourcePath,.targetPath,.repository,.importPolicy,.expectedImportedFiles] | @tsv' "$map_file")

[[ "$total_files" -eq 650 ]] || die "source 文件总数应为 650，实际为 $total_files；基线可能已变化"
[[ "$total_imported_files" -eq 582 ]] ||
  die "净化后文件总数应为 582，实际为 $total_imported_files；迁移策略可能已变化"

printf '\n预检通过：5 个 source，共 %d 个源文件，计划导入 %d 个文件。\n' \
  "$total_files" "$total_imported_files"
if [[ "$mode" == "verify-only" ]]; then
  printf '未传入 --apply；没有创建目标目录。\n'
  exit 0
fi

mkdir -p "$destination"
git init -q -b main "$destination"

while IFS=$'\t' read -r source_path target_path commit; do
  mkdir -p "$destination/$target_path"
  git -C "$source_workspace/$source_path" archive --format=tar "$commit" |
    tar --extract --file=- --directory="$destination/$target_path" --no-same-owner
done < <(jq -r '.components[] | [.sourcePath,.targetPath] | @tsv' "$map_file" |
  while IFS=$'\t' read -r source_path target_path; do
    commit="$(git -C "$source_workspace" ls-tree "$source_ref" -- "$source_path" | awk '{print $3}')"
    printf '%s\t%s\t%s\n' "$source_path" "$target_path" "$commit"
  done)

node "$sanitizer" "$destination" >"$sanitization_report"
jq -e '.schemaVersion == 1 and .policy == "security-sanitized-snapshot"' \
  "$sanitization_report" >/dev/null || die "净化报告格式无效"

mkdir -p \
  "$destination/docs/architecture" \
  "$destination/migration/tooling" \
  "$destination/.local"
git -C "$source_workspace" show "$source_ref:CONTEXT.md" >"$destination/docs/architecture/domain-context.md"
cp -- "$map_file" "$destination/migration/tooling/snapshot-map.json"
cp -- "$sanitizer" "$destination/migration/tooling/sanitize-snapshot.mjs"
cp -- "$script_dir/create-snapshot" "$destination/migration/tooling/create-snapshot"
chmod 0755 \
  "$destination/migration/tooling/sanitize-snapshot.mjs" \
  "$destination/migration/tooling/create-snapshot"

cat >"$destination/.gitignore" <<'EOF'
/.artifacts/
/.local/
/node_modules/
*.local
*.local.json
*.local.yaml
*.local.yml
EOF

cat >"$destination/README.md" <<EOF
# TrojanPanel Next

\`trojanpanelnext\` 是由 TrojanPanel 社区项目演进而来的产品 monorepo。控制面、Web、
节点 Agent、公共安装器和文档站从 workspace 基线 \`${source_ref}\` 迁移到一个
无父提交的安全净化 root commit。

迁移前历史保留在原组件仓库；机器可读来源见
\`migration/source-baseline.json\`。其中逐项记录了原始 commit/tree、导入策略、
示例凭据脱敏和已跟踪文档编译产物排除情况。

本次迁移使用的映射、生成器和净化器已固化在 \`migration/tooling/\`；生成器可通过
\`--source-workspace\` 指向保留的旧 workspace 后重放。

当前目录是 M0 内容快照。统一工作区、契约、CI 和发布流程将在后续独立提交中建立。
EOF

cat >"$destination/migration/README.md" <<EOF
# Migration evidence

此目录记录从旧 workspace \`${source_ref}\` 创建 M0 根提交的来源、策略和工具：

- \`source-baseline.json\`：来源 commit/tree、导入策略、净化计数；
- \`tooling/snapshot-map.json\`：组件到 monorepo 的固定映射；
- \`tooling/sanitize-snapshot.mjs\`：可失败关闭的确定性净化规则；
- \`tooling/create-snapshot\`：预检、导入、提交和结构验证入口。

运行时证据（测试、泄露扫描、本地 source bundle）位于被忽略的 \`.local/\`，不会随
产品仓库发布；正式归档时应将其复制到受控的迁移档案位置。
EOF

jq -s \
  --arg capturedAt "$captured_at" \
  --arg sourceCommitDate "$source_commit_date" \
  --arg workspaceRepository "git@github.com:1linhao/trojanpanel-fork.git" \
  --arg workspaceCommit "$source_ref" \
  --arg workspaceTree "$source_tree" \
  --argjson totalFiles "$total_files" \
  --argjson totalImportedFiles "$total_imported_files" \
  --slurpfile sanitization "$sanitization_report" \
  '{
    schemaVersion:1,
    historyPolicy:"security-sanitized-snapshot-without-parents",
    capturedAt:$capturedAt,
    workspace:{repository:$workspaceRepository,commit:$workspaceCommit,tree:$workspaceTree,committedAt:$sourceCommitDate},
    sources:.,
    totalSourceFiles:$totalFiles,
    totalImportedFiles:$totalImportedFiles,
    sanitization:$sanitization[0],
    tooling:{
      map:"migration/tooling/snapshot-map.json",
      sanitizer:"migration/tooling/sanitize-snapshot.mjs",
      generator:"migration/tooling/create-snapshot"
    }
  }' "$sources_ndjson" >"$destination/migration/source-baseline.json"

cat >"$commit_message" <<EOF
chore(repo): initialize product monorepo from workspace snapshot

Start the new product history from the verified workspace composition at
2026-09-04. Pre-migration history remains available in the archived source
repositories.

Source-Workspace: $source_ref
Source-trojan-panel: $(jq -r 'select(.name=="trojan-panel") | .commit' "$sources_ndjson")
Source-trojan-panel-ui: $(jq -r 'select(.name=="trojan-panel-ui") | .commit' "$sources_ndjson")
Source-trojan-panel-core: $(jq -r 'select(.name=="trojan-panel-core") | .commit' "$sources_ndjson")
Source-installer: $(jq -r 'select(.name=="trojan-panel-install-script") | .commit' "$sources_ndjson")
Source-docs: $(jq -r 'select(.name=="trojanpanel.github.io") | .commit' "$sources_ndjson")
History-Policy: snapshot-without-parents
Snapshot-Policy: security-sanitized
EOF

git -C "$destination" add --all
git -C "$destination" commit --quiet --no-gpg-sign --file="$commit_message"
baseline_date="$(git -C "$source_workspace" show -s --format=%cd --date=format:%Y-%m-%d "$source_ref")"
baseline_tag="migration-baseline-$baseline_date"
git -C "$destination" tag --annotate "$baseline_tag" --message="Snapshot baseline from $source_ref"

root_commit="$(git -C "$destination" rev-parse HEAD)"
commit_count="$(git -C "$destination" rev-list --count HEAD)"
parent_count="$(git -C "$destination" rev-list --parents -n 1 HEAD | awk '{print NF-1}')"
[[ "$commit_count" -eq 1 ]] || die "新仓 commit 数量不是 1"
[[ "$parent_count" -eq 0 ]] || die "新仓 root commit 存在 parent"
[[ ! -e "$destination/.gitmodules" ]] || die "新仓不应包含 .gitmodules"
[[ -z "$(git -C "$destination" ls-files --stage | awk '$1==160000 {print}')" ]] ||
  die "新仓仍包含 gitlink"

verified_files=0
exact_components=0
sanitized_components=0
while IFS=$'\t' read -r name target_path expected_tree import_policy expected_files; do
  actual_tree="$(git -C "$destination" rev-parse "HEAD:$target_path")"
  if [[ "$import_policy" == "exact" ]]; then
    [[ "$actual_tree" == "$expected_tree" ]] ||
      die "$name 目标 tree 不一致：expected=$expected_tree actual=$actual_tree"
    exact_components=$((exact_components + 1))
  else
    sanitized_components=$((sanitized_components + 1))
  fi
  actual_files="$(git -C "$destination" ls-tree -r --name-only "HEAD:$target_path" | wc -l)"
  [[ "$actual_files" -eq "$expected_files" ]] ||
    die "$name 文件数不一致：expected=$expected_files actual=$actual_files"
  verified_files=$((verified_files + actual_files))
done < <(jq -r '[.name,.targetPath,.tree,.importPolicy,.expectedImportedFiles] | @tsv' "$sources_ndjson")
[[ "$verified_files" -eq "$total_imported_files" ]] || die "目标文件总数校验失败"
[[ "$exact_components" -eq 2 && "$sanitized_components" -eq 3 ]] ||
  die "导入策略组件数量校验失败"

jq -n \
  --arg verifiedAt "$(date --iso-8601=seconds)" \
  --arg rootCommit "$root_commit" \
  --arg baselineTag "$baseline_tag" \
  --arg sourceWorkspace "$source_workspace" \
  --arg sourceCommit "$source_ref" \
  --argjson commitCount "$commit_count" \
  --argjson parentCount "$parent_count" \
  --argjson sourceFiles "$total_files" \
  --argjson verifiedImportedFiles "$verified_files" \
  --argjson exactComponents "$exact_components" \
  --argjson sanitizedComponents "$sanitized_components" \
  '{
    schemaVersion:1,
    status:"passed",
    verifiedAt:$verifiedAt,
    rootCommit:$rootCommit,
    baselineTag:$baselineTag,
    source:{workspace:$sourceWorkspace,commit:$sourceCommit},
    checks:{
      commitCount:$commitCount,
      parentCount:$parentCount,
      noGitmodules:true,
      noGitlinks:true,
      sourceFiles:$sourceFiles,
      verifiedImportedFiles:$verifiedImportedFiles,
      exactSubtreeTreesMatch:true,
      exactComponents:$exactComponents,
      sanitizedComponents:$sanitizedComponents,
      sanitizationVerified:true,
      secretScan:"not-run"
    }
  }' >"$destination/.local/migration-verification.json"

[[ -z "$(git -C "$destination" status --porcelain --untracked-files=all)" ]] ||
  die "新仓创建后工作树不干净"

printf '\nM0 快照创建成功。\n'
printf '新 root commit：%s\n' "$root_commit"
printf '基线 tag：%s\n' "$baseline_tag"
printf '验证报告：%s/.local/migration-verification.json\n' "$destination"
printf '注意：尚未执行 secret scan、远端创建、push 或部署。\n'
