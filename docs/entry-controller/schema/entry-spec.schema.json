{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trojanpanelnext.example/schema/entry-spec-v1.json",
  "title": "TrojanPanel Next EntrySpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "deployment_id", "provider", "purpose", "domain", "certificate", "ingress"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "deployment_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "provider": {"enum": ["caddy-legacy", "nginx-certbot", "external"]},
    "purpose": {"enum": ["web", "node"]},
    "domain": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed_dir"],
      "properties": {
        "managed_dir": {"type": "string", "pattern": "^/"},
        "source_dir": {"type": "string", "pattern": "^/"},
        "cert_file": {"type": "string", "minLength": 1},
        "key_file": {"type": "string", "minLength": 1},
        "email": {"type": "string", "format": "email"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web_upstream": {"type": "string", "pattern": "^(127\\.0\\.0\\.1|\\[::1\\]):[0-9]{1,5}$"},
        "node_exposure": {"const": "direct"},
        "route_manifest": {"type": "string", "pattern": "^/"},
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["listen", "root"],
            "properties": {
              "listen": {"type": "string", "pattern": "^(127\\.0\\.0\\.1|\\[::1\\]):[0-9]{1,5}$"},
              "root": {"type": "string", "pattern": "^/"}
            }
          }
        }
      }
    },
    "external_driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "path"],
      "properties": {
        "protocol_version": {"const": 1},
        "path": {"type": "string", "pattern": "^/"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"purpose": {"const": "web"}}},
      "then": {"properties": {"ingress": {"required": ["web_upstream"]}}}
    },
    {
      "if": {"properties": {"purpose": {"const": "node"}}},
      "then": {"properties": {"ingress": {"required": ["node_exposure", "route_manifest"]}}}
    },
    {
      "if": {"properties": {"provider": {"const": "external"}}},
      "then": {"required": ["external_driver"], "properties": {"certificate": {"required": ["source_dir"]}}}
    }
  ]
}
