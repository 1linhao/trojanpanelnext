diff --git a/trojan_panel_traffic.go b/trojan_panel_traffic.go
new file mode 100644
index 0000000..4b48e29
--- /dev/null
+++ b/trojan_panel_traffic.go
@@ -0,0 +1,94 @@
+package forwardproxy
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"sync"
+
+	caddy "github.com/caddyserver/caddy/v2"
+)
+
+func init() {
+	caddy.RegisterModule(TrafficAPI{})
+}
+
+type TrafficAPI struct{}
+
+func (TrafficAPI) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{
+		ID:  "admin.api.trojan_panel_naiveproxy_traffic",
+		New: func() caddy.Module { return new(TrafficAPI) },
+	}
+}
+
+func (TrafficAPI) Routes() []caddy.AdminRoute {
+	return []caddy.AdminRoute{{
+		Pattern: "/trojan-panel/naiveproxy/traffic",
+		Handler: caddy.AdminHandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+			if r.Method != http.MethodGet {
+				w.WriteHeader(http.StatusMethodNotAllowed)
+				return nil
+			}
+			reset := r.URL.Query().Get("reset") == "true"
+			w.Header().Set("Content-Type", "application/json")
+			return json.NewEncoder(w).Encode(trafficSnapshot(reset))
+		}),
+	}}
+}
+
+type userTraffic struct {
+	Rx uint64 `json:"rx"`
+	Tx uint64 `json:"tx"`
+}
+
+var trafficCounters = struct {
+	sync.Mutex
+	users map[string]userTraffic
+}{
+	users: make(map[string]userTraffic),
+}
+
+func recordTraffic(key string, rx uint64, tx uint64) {
+	if key == "" || (rx == 0 && tx == 0) {
+		return
+	}
+	trafficCounters.Lock()
+	defer trafficCounters.Unlock()
+	traffic := trafficCounters.users[key]
+	traffic.Rx += rx
+	traffic.Tx += tx
+	trafficCounters.users[key] = traffic
+}
+
+func trafficSnapshot(reset bool) map[string]userTraffic {
+	trafficCounters.Lock()
+	defer trafficCounters.Unlock()
+	snapshot := make(map[string]userTraffic, len(trafficCounters.users))
+	for key, traffic := range trafficCounters.users {
+		snapshot[key] = traffic
+	}
+	if reset {
+		trafficCounters.users = make(map[string]userTraffic)
+	}
+	return snapshot
+}
+
+func proxyAuthPassword(r *http.Request) string {
+	parts := strings.SplitN(r.Header.Get("Proxy-Authorization"), " ", 2)
+	if len(parts) != 2 || strings.ToLower(parts[0]) != "basic" {
+		return ""
+	}
+	decoded, err := base64.StdEncoding.DecodeString(parts[1])
+	if err != nil {
+		return ""
+	}
+	credentials := string(decoded)
+	index := strings.IndexByte(credentials, ':')
+	if index < 0 || index+1 >= len(credentials) {
+		return ""
+	}
+	return credentials[index+1:]
+}
+var _ caddy.AdminRouter = (*TrafficAPI)(nil)
